<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Wichtige Informationen zum Probestyling und zur Vorbereitung für Bräute bei sasatrumua.">
  <title>Infos für die Bräute | sasatrumua</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Alex+Brush&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
  <style>
    :root { --ink:#292522; --muted:#71675f; --gold:#b58a43; --line:rgba(99,77,49,.15); --card:rgba(255,255,255,.20); --clean:"DM Sans",Arial,sans-serif; --script:"Alex Brush",cursive; }
    * { box-sizing:border-box; }
    html { scroll-behavior:smooth; }
    body { margin:0; overflow-x:hidden; color:var(--ink); font-family:var(--clean); background:#f3eee7; }
    body::before { content:""; position:fixed; z-index:-2; inset:0; background:url("https://github.com/Sasatrumua/sasatrumua.github.io/blob/main/Marmor.png?raw=true") center center / cover no-repeat; pointer-events:none; }
    body::after { content:""; position:fixed; z-index:-1; inset:0; background:rgba(248,245,240,.12); pointer-events:none; }
    a { color:inherit; text-decoration:none; }
    img { display:block; max-width:100%; }
    .container { width:min(calc(100% - 64px),1180px); margin:0 auto; }
    .site-header { width:100%; padding:14px 0 11px; text-align:center; background:rgba(250,248,244,.28); }
    .header-inner { width:min(calc(100% - 64px),1440px); margin:0 auto; text-align:center; }
    .logo-link { display:inline-block; line-height:0; }
    .logo-link:focus-visible { outline:1px solid var(--gold); outline-offset:5px; }
    .logo { width:116px; margin:0 auto 5px; }
    .desktop-nav { display:flex; justify-content:center; align-items:center; gap:19px; padding:3px 0 8px; font-size:10px; font-weight:500; letter-spacing:.18em; text-transform:uppercase; }
    .desktop-nav a { position:relative; padding:4px 0; white-space:nowrap; }
    .desktop-nav a::after { content:""; position:absolute; left:50%; bottom:0; width:0; height:1px; background:var(--gold); transform:translateX(-50%); transition:width .24s ease; }
    .desktop-nav a:hover::after,.desktop-nav a:focus-visible::after,.desktop-nav a[aria-current="page"]::after { width:100%; }
    .menu-toggle,.mobile-menu { display:none; }
    main { padding:66px 0 84px; }

    .hero { position:relative; min-height:430px; overflow:hidden; margin-bottom:70px; box-shadow:0 14px 38px rgba(82,61,39,.10); }
    .hero::after { content:""; position:absolute; inset:0; background:linear-gradient(90deg,rgba(255,252,247,.22),rgba(255,252,247,.03)); pointer-events:none; }
    .hero img { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:center center; }
    /* Die Überschrift liegt bewusst im freien, hellen linken Bildbereich und nicht über der Braut. */
    .hero-title { position:absolute; z-index:1; top:18%; left:7%; width:min(48%,500px); margin:0; color:var(--gold); font-family:var(--script); font-size:clamp(53px,6vw,88px); font-weight:400; line-height:.88; text-align:left; text-shadow:0 1px 11px rgba(255,255,255,.72); }
    .hero-title::after { content:""; display:block; width:54px; height:1px; margin:25px 0 0 4px; background:var(--gold); }

    .intro-copy { max-width:780px; margin:0 auto 54px; text-align:center; }
    .intro-copy p { margin:0; color:var(--muted); font-size:15px; font-weight:300; letter-spacing:.018em; line-height:1.92; }
    .info-list { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:28px; align-items:stretch; }
    .info-card { padding:34px 36px 35px; border:1px solid var(--line); background:var(--card); box-shadow:0 10px 26px rgba(82,61,39,.045); }
    .info-card h2 { margin:0 0 19px; color:var(--ink); font-family:var(--script); font-size:43px; font-weight:400; line-height:.95; text-align:center; }
    .info-card h2::after { content:""; display:block; width:32px; height:1px; margin:17px auto 0; background:var(--gold); }
    .info-card p { margin:0; color:var(--muted); font-size:14px; font-weight:300; letter-spacing:.012em; line-height:1.84; }
    .info-card p + p { margin-top:17px; }
    .info-card a { color:var(--ink); border-bottom:1px solid rgba(181,138,67,.68); }
    .price-note { color:var(--gold)!important; font-family:var(--script); font-size:28px!important; line-height:1.1!important; text-align:center; }
    footer { width:min(calc(100% - 64px),1180px); margin:0 auto; padding:28px 0 23px; border-top:1px solid var(--line); text-align:center; color:var(--muted); font-size:10px; font-weight:400; letter-spacing:.1em; text-transform:uppercase; }
    .footer-links { display:flex; justify-content:center; flex-wrap:wrap; gap:13px; margin:12px 0; }
    .reveal { opacity:0; transform:translateY(22px); transition:opacity .76s ease,transform .76s ease; }
    .reveal.visible { opacity:1; transform:none; }
    .gold-dust-layer { position:fixed; inset:0; z-index:999; overflow:hidden; pointer-events:none; }
    .gold-dust { position:fixed; width:3px; height:3px; border-radius:50%; pointer-events:none; opacity:0; background:radial-gradient(circle,rgba(255,255,255,1) 0 16%,rgba(255,234,183,1) 28%,rgba(211,164,78,.95) 60%,rgba(177,124,45,0) 79%); box-shadow:0 0 3px rgba(255,247,221,.98),0 0 8px rgba(213,165,79,.65); transform:translate(-50%,-50%) scale(.2); will-change:transform,opacity; }

    @media (max-width:920px) { .header-inner,.container,footer { width:min(calc(100% - 34px),760px); } .hero { min-height:360px; margin-bottom:54px; } .info-card { padding:30px 26px; } }
    @media (max-width:620px) {
      .container,footer { width:min(calc(100% - 28px),1440px); }
      .site-header { padding:12px 0 10px; background:transparent; }
      .header-inner { display:flex; flex-direction:column; align-items:center; width:100%; margin:0; text-align:center; }
      .logo-link { display:block; width:102px; margin:0 auto; line-height:0; } .logo { width:102px; margin:0; } .desktop-nav { display:none; }
      .menu-toggle { display:inline-flex; align-items:center; justify-content:center; gap:9px; align-self:center; margin:10px auto 2px; padding:9px 13px; border:1px solid rgba(83,65,52,.24); border-radius:999px; color:var(--ink); background:rgba(255,255,255,.14); font-family:var(--clean); font-size:10px; font-weight:500; letter-spacing:.12em; text-transform:uppercase; cursor:pointer; }
      .burger-lines,.burger-lines::before,.burger-lines::after { display:block; width:17px; height:1px; background:var(--ink); transition:transform .22s ease; } .burger-lines { position:relative; } .burger-lines::before,.burger-lines::after { content:""; position:absolute; left:0; } .burger-lines::before { top:-5px; } .burger-lines::after { top:5px; }
      .menu-toggle[aria-expanded="true"] .burger-lines { background:transparent; } .menu-toggle[aria-expanded="true"] .burger-lines::before { transform:translateY(5px) rotate(45deg); } .menu-toggle[aria-expanded="true"] .burger-lines::after { transform:translateY(-5px) rotate(-45deg); }
      .mobile-menu { display:grid; grid-template-rows:0fr; width:100%; overflow:hidden; margin:0; transition:grid-template-rows .26s ease; } .mobile-menu.open { grid-template-rows:1fr; } .mobile-menu-inner { display:grid; width:min(calc(100% - 28px),420px); min-height:0; margin:0 auto; }
      .mobile-menu a { padding:13px 10px; border-bottom:1px solid rgba(68,53,43,.12); font-size:12px; font-weight:500; letter-spacing:.12em; text-align:center; text-transform:uppercase; } .mobile-menu a:last-child { border-bottom:0; }
      main { padding:45px 0 64px; }
      .hero { min-height:278px; margin-bottom:43px; } .hero img { object-position:59% center; }
      .hero-title { top:16%; left:8%; width:50%; font-size:49px; line-height:.86; } .hero-title::after { width:42px; margin-top:17px; margin-left:2px; }
      .intro-copy { margin-bottom:36px; } .intro-copy p { font-size:14px; line-height:1.85; }
      .info-list { grid-template-columns:1fr; gap:18px; } .info-card { padding:29px 25px 28px; } .info-card h2 { margin-bottom:18px; font-size:42px; } .info-card p { font-size:14px; line-height:1.81; } .price-note { font-size:28px!important; }
      .gold-dust-layer { display:none; }
    }
    @media (prefers-reduced-motion:reduce) { html { scroll-behavior:auto; } *,*::before,*::after { transition:none!important; animation:none!important; } .reveal { opacity:1; transform:none; } .gold-dust-layer { display:none; } }
  </style>
</head>
<body>
  <div class="gold-dust-layer" aria-hidden="true"></div>
  <header class="site-header"><div class="header-inner">
