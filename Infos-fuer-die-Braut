    <nav class="desktop-nav" aria-label="Hauptnavigation"><a href="index.html">Home</a><a href="ueber-mich.html">Über mich</a><a href="reviews.html">Reviews</a><a href="portfolio.html">Portfolio</a><a href="dienstleistungen.html">Dienstleistungen</a><a href="braut-infos.html" aria-current="page">Infos für die Braut</a><a href="kontakt.html">Kontakt</a></nav>
