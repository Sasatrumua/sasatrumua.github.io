  <script>
    const menuToggle=document.querySelector('.menu-toggle');const mobileMenu=document.querySelector('.mobile-menu');
    menuToggle.addEventListener('click',()=>{const isOpen=menuToggle.getAttribute('aria-expanded')==='true';menuToggle.setAttribute('aria-expanded',String(!isOpen));mobileMenu.classList.toggle('open',!isOpen);});
    document.querySelectorAll('.mobile-menu a').forEach(link=>link.addEventListener('click',()=>{menuToggle.setAttribute('aria-expanded','false');mobileMenu.classList.remove('open');}));
    const observer=new IntersectionObserver(entries=>entries.forEach(entry=>{if(entry.isIntersecting)entry.target.classList.add('visible');}),{threshold:.1});document.querySelectorAll('.reveal').forEach(element=>observer.observe(element));
    const dustLayer=document.querySelector('.gold-dust-layer');const reducedMotion=window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if(!reducedMotion&&window.innerWidth>620){let previousX=null,previousY=null,lastDust=0;function makeDust(x,y,quantity){for(let i=0;i<quantity;i++){const dust=document.createElement('span');dust.className='gold-dust';const size=1+Math.random()*2.6,angle=Math.random()*Math.PI*2,distance=4+Math.random()*25,driftX=Math.cos(angle)*distance,driftY=Math.sin(angle)*distance-3-Math.random()*12;dust.style.width=size+'px';dust.style.height=size+'px';dust.style.left=(x+(Math.random()-.5)*10)+'px';dust.style.top=(y+(Math.random()-.5)*10)+'px';dust.style.opacity=(.54+Math.random()*.38).toFixed(2);dustLayer.appendChild(dust);requestAnimationFrame(()=>{dust.style.transition='transform 850ms cubic-bezier(.16,.84,.35,1), opacity 850ms ease';dust.style.transform=`translate(calc(-50% + ${driftX}px), calc(-50% + ${driftY}px)) scale(${.62+Math.random()*.75})`;dust.style.opacity='0';});window.setTimeout(()=>dust.remove(),890);}}document.addEventListener('mousemove',event=>{const now=performance.now();if(previousX!==null){const dx=event.clientX-previousX,dy=event.clientY-previousY,distance=Math.hypot(dx,dy),steps=Math.max(1,Math.ceil(distance/7));if(now-lastDust>12||distance>2){for(let step=0;step<=steps;step++){const progress=step/steps;makeDust(previousX+dx*progress,previousY+dy*progress,2+Math.floor(Math.random()*2));}lastDust=now;}}else{makeDust(event.clientX,event.clientY,4);}previousX=event.clientX;previousY=event.clientY;},{passive:true});}
  </script>
